# Enux Environment Variables Configuration
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control

# =============================================================================
# API Configuration
# =============================================================================

# Base URL for API endpoints
# Development: http://localhost:3000/api
# Production: https://your-api-domain.com/api
VITE_API_BASE_URL=http://localhost:3000/api

# API timeout in milliseconds
VITE_API_TIMEOUT=30000

# =============================================================================
# N8n Webhook Configuration (Optional)
# =============================================================================

# N8n webhook URL for AI assistant integration
# Leave empty to disable webhook functionality
# Example: https://your-n8n-instance.com/webhook/your-webhook-id
VITE_N8N_WEBHOOK_URL=

# =============================================================================
# Feature Flags
# =============================================================================

# Enable webhook configuration UI in AI Assistant
VITE_ENABLE_WEBHOOK_CONFIG=true

# Enable analytics tracking
VITE_ANALYTICS_ENABLED=false

# Enable debug mode (shows additional logging)
VITE_DEBUG_MODE=false

# =============================================================================
# Analytics & Monitoring (Optional)
# =============================================================================

# Analytics service API key (e.g., Google Analytics, Mixpanel)
VITE_ANALYTICS_KEY=

# Sentry DSN for error tracking
VITE_SENTRY_DSN=

# Environment name for monitoring
VITE_ENVIRONMENT=development

# =============================================================================
# Authentication (Future)
# =============================================================================

# Auth0 / OAuth configuration (for future implementation)
# VITE_AUTH_DOMAIN=
# VITE_AUTH_CLIENT_ID=
# VITE_AUTH_AUDIENCE=

# =============================================================================
# CDN & Assets (Optional)
# =============================================================================

# CDN URL for static assets
# VITE_CDN_URL=

# Avatar service URL
# VITE_AVATAR_SERVICE_URL=

# =============================================================================
# Development Settings
# =============================================================================

# Port for development server (default: 5173)
# VITE_PORT=5173

# Host for development server
# VITE_HOST=localhost

# =============================================================================
# Notes
# =============================================================================
#
# 1. All variables prefixed with VITE_ are exposed to the client-side code
# 2. DO NOT store sensitive secrets in VITE_ variables - they are publicly accessible
# 3. For production, use environment variables provided by your hosting platform
# 4. See Vite documentation for more info: https://vitejs.dev/guide/env-and-mode.html
#
